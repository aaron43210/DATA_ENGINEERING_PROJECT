# ─────────────────────────────────────────────────────────────────────────────
# Geospatial Data Platform — environment template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# NEVER commit a populated `.env`. Use strong, unique secrets per environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenWeatherMap ───────────────────────────────────────────────────────────
# Required. Free key: https://openweathermap.org/api
# No Mock Data Policy: a missing/`demo` key makes weather ingestion fail fast.
OPENWEATHER_API_KEY=

# ── PostgreSQL (geoplatform app DB + Airflow metadata DB) ────────────────────
POSTGRES_PASSWORD=
AIRFLOW_DB_PASSWORD=

# ── Airflow ──────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_PASSWORD=

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── LakeFS (data versioning over MinIO) ──────────────────────────────────────
LAKEFS_ACCESS_KEY=
LAKEFS_SECRET_KEY=
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# ── FastAPI service ──────────────────────────────────────────────────────────
JWT_SECRET=
API_KEY=
# Comma-separated list of allowed CORS origins (no wildcard with credentials).
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── DataHub ──────────────────────────────────────────────────────────────────
DATAHUB_SECRET=

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
