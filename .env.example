# ─────────────────────────────────────────────────────────────────────────────
# Cloud-Native Geospatial Data Platform — Environment Configuration Template
# Angel's Scope: MinIO (Bronze/Silver/Gold), Postgres/PostGIS, Overpass API,
#                Apache Iceberg REST Catalog, Airflow, and Flink
#
# Copy to `.env` and supply actual values: cp .env.example .env
# NEVER commit a populated `.env` file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── General Platform Settings ────────────────────────────────────────────────
PLATFORM_ENV=development
LOG_LEVEL=INFO

# ── PostgreSQL & PostGIS (Core Storage & Metastore) ──────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geoplatform
POSTGRES_USER=geoplatform
# Set a strong password in production (e.g. openssl rand -hex 16)
POSTGRES_PASSWORD=geoplatform_secure_pass_2026
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_meta_pass_2026

# Use 'require' (or 'verify-full') on RDS. Read by Airflow, dbt, Flink and the API.
POSTGRES_SSLMODE=prefer

# ── MinIO (S3-Compatible Object Storage - Raw Bronze & Iceberg Warehouse) ─────
# Local only. On AWS, S3 replaces MinIO and these are not used.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_secret_2026
MINIO_REGION=us-east-1

# S3 Bucket Names
BUCKET_BRONZE=bronze
BUCKET_SILVER=silver
BUCKET_GOLD=gold
BUCKET_WAREHOUSE=warehouse
# Bronze lifecycle: raw objects expire after this many days (GDPR retention)
BRONZE_RETENTION_DAYS=365
BRONZE_NONCURRENT_DAYS=30

# Object storage clients (boto3, PyIceberg) use the standard AWS SDK variables.
# docker-compose sets AWS_ENDPOINT_URL_S3=http://minio:9000 and maps the MinIO root
# keys onto AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY. On AWS leave all three unset so
# the clients use real S3 and the IAM role.
AWS_DEFAULT_REGION=us-east-1

# ── OpenStreetMap (OSM) Overpass API Ingestion ──────────────────────────────
# Public Overpass interpreter or internal mirror
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_MIRROR_URLS=https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_SECONDS=180
# Bounding box for Kerala: (south, west, north, east)
OVERPASS_BBOX=8.1,74.8,12.8,77.5

# ── Apache Iceberg REST Catalog (Storage Layer - Silver/Parquet) ─────────────
ICEBERG_REST_PORT=8181
ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3://warehouse/
ICEBERG_CATALOG_NAME=geoplatform_catalog

# ── Apache Airflow (Orchestration & Batch Ingestion) ─────────────────────────
# Linux: set to the output of `id -u` so tasks can write to mounted folders.
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqBp0Y=
AIRFLOW_SECRET_KEY=geoplatform_airflow_webserver_secret_2026
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_password_2026
AIRFLOW_ADMIN_EMAIL=angel@geoplatform.local
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false

# ── Data Quality Thresholds ──────────────────────────────────────────────────
QUALITY_MIN_PASS_RATE=95.0

# ── Redpanda / Kafka (Streaming Broker) ──────────────────────────────────────
REDPANDA_BROKERS=redpanda:9092
SCHEMA_REGISTRY_URL=http://redpanda:8081
TOPIC_SENSOR_LIVE=sensor.live
TOPIC_WEATHER_LIVE=weather.live
TOPIC_SENSOR_DLT=sensor.dead-letter
TOPIC_WEATHER_DLT=weather.dead-letter
TOPIC_QUALITY_ALERTS=platform.quality.alerts
TOPIC_PARTITIONS=3
TOPIC_RETENTION_MS=604800000

# ── Weather producer (docker compose --profile weather) ──────────────────────
# Required for the weather producer; a blank/placeholder key makes it exit at startup.
OPENWEATHER_API_KEY=
POLL_INTERVAL_SECONDS=60
MAX_WEATHER_AGE_SECONDS=900

# ── Sensor producer: MQTT bridge (docker compose --profile sensor) ───────────
# No public broker is configured by default. Certificates go in MQTT_CERTS_DIR and the
# MQTT_*_CERT/KEY values are paths inside the container (/run/mqtt-certs/...).
MQTT_BROKER=
MQTT_PORT=8883
MQTT_TOPIC=geoplatform/sensors/#
MQTT_QOS=1
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=
MQTT_CERTS_DIR=./secrets/mqtt-certs
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_KEY_PASSWORD=

# ── Apache Flink (Stream Processing) ─────────────────────────────────────────
FLINK_JOBMANAGER_HOST=flink-jobmanager
FLINK_TASK_SLOTS=4
FLINK_PARALLELISM=2
FLINK_JOBMANAGER_MEMORY=1024m
FLINK_TASKMANAGER_MEMORY=2048m
CHECKPOINT_INTERVAL_MS=10000
WATERMARK_OUT_OF_ORDER_SECONDS=10
KAFKA_GROUP_PREFIX=geoplatform-flink

# ── FastAPI (serving layer) ──────────────────────────────────────────────────
# Required; the API refuses to start without it (openssl rand -hex 32).
JWT_SECRET=
CORS_ALLOW_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=

# ── SMTP (Airflow failure email alerts) ──────────────────────────────────────
# Leave AIRFLOW__SMTP__SMTP_HOST blank to disable email alerts entirely.
AIRFLOW__SMTP__SMTP_HOST=
AIRFLOW__SMTP__SMTP_PORT=465
AIRFLOW__SMTP__SMTP_USER=
AIRFLOW__SMTP__SMTP_PASSWORD=
AIRFLOW__SMTP__SMTP_MAIL_FROM=airflow@geoplatform.local
AIRFLOW_ALERT_EMAIL=

# ── Grafana (docker compose --profile monitoring) ────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=
