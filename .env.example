# ─────────────────────────────────────────────────────────────────────────────
# Cloud-Native Geospatial Data Platform — Environment Configuration Template
# Angel's Scope: MinIO (Bronze/Silver/Gold), Postgres/PostGIS, Overpass API,
#                Apache Iceberg REST Catalog, Airflow, and Flink
#
# Copy to `.env` and supply actual values: cp .env.example .env
# NEVER commit a populated `.env` file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── General Platform Settings ────────────────────────────────────────────────
PLATFORM_ENV=development
LOG_LEVEL=INFO

# ── PostgreSQL & PostGIS (Core Storage & Metastore) ──────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=geoplatform
POSTGRES_USER=geoplatform
# Set a strong password in production (e.g. openssl rand -hex 16)
POSTGRES_PASSWORD=geoplatform_secure_pass_2026
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_meta_pass_2026

# ── MinIO (S3-Compatible Object Storage - Raw Bronze & Iceberg Warehouse) ─────
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_secret_2026
MINIO_REGION=us-east-1

# S3 Bucket Names
BUCKET_BRONZE=bronze
BUCKET_SILVER=silver
BUCKET_GOLD=gold
BUCKET_WAREHOUSE=warehouse

# AWS SDK / S3 Client compatibility variables
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_secure_secret_2026
AWS_DEFAULT_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PATH_STYLE_ACCESS=true

# ── OpenStreetMap (OSM) Overpass API Ingestion ──────────────────────────────
# Public Overpass interpreter or internal mirror
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=60
# Bounding box for Kerala: (south, west, north, east)
OVERPASS_BBOX=8.1,74.8,12.8,77.5

# ── Apache Iceberg REST Catalog (Storage Layer - Silver/Parquet) ─────────────
ICEBERG_REST_PORT=8181
ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3://warehouse/
ICEBERG_CATALOG_NAME=geoplatform_catalog

# ── Apache Airflow (Orchestration & Batch Ingestion) ─────────────────────────
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1-python3.10
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqBp0Y=
AIRFLOW_SECRET_KEY=geoplatform_airflow_webserver_secret_2026
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_password_2026
AIRFLOW_ADMIN_EMAIL=angel@geoplatform.local
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false

# ── Data Quality Thresholds ──────────────────────────────────────────────────
QUALITY_MIN_PASS_RATE=95.0

# ── Redpanda / Kafka (Streaming Broker) ──────────────────────────────────────
REDPANDA_BROKERS=redpanda:9092
SCHEMA_REGISTRY_URL=http://redpanda:8081
TOPIC_SENSOR_LIVE=sensor.live
TOPIC_WEATHER_LIVE=weather.live
TOPIC_QUALITY_ALERTS=platform.quality.alerts

# ── Apache Flink (Stream Processing) ─────────────────────────────────────────
FLINK_JOBMANAGER_HOST=flink-jobmanager
FLINK_JOBMANAGER_PORT=8081
FLINK_TASK_SLOTS=4
FLINK_PARALLELISM=2

# ── OpenLineage & Metadata Governance ────────────────────────────────────────
OPENLINEAGE_URL=http://openmetadata:8585
OPENLINEAGE_NAMESPACE=geoplatform
