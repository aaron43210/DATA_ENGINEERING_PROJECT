# Copy to .env and fill only values needed by the profiles you run.
# Never commit .env. Blank values are intentionally not working credentials.
MQTT_BROKER=
MQTT_PORT=8883
MQTT_TOPIC=geoplatform/sensors/#
MQTT_QOS=1
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=
MQTT_CERTS_DIR=./mqtt-certs
# Paths inside the mounted folder above; leave blank for broker system CA / user-password auth.
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_KEY_PASSWORD=
POSTGRES_DB=geoplatform
POSTGRES_USER=geoplatform
POSTGRES_PASSWORD=
CONSUMER_GROUP_ID=lubaba-unified-processor
OPENWEATHER_API_KEY=
POLL_INTERVAL_SECONDS=60
MAX_WEATHER_AGE_SECONDS=900
