# Pipeline host on EC2 (docker-compose.yml + docker-compose.aws.yml).
# Copy to .env on the instance, fill every <...>, then: chmod 600 .env
# RDS replaces the postgres container, S3 replaces MinIO (instance role, no keys).

PLATFORM_ENV=production
LOG_LEVEL=INFO
AWS_DEFAULT_REGION=us-east-1

# ── RDS (terraform output rds_endpoint, without the :5432) ───────────────────
POSTGRES_HOST=<geoplatform-postgres.xxxxxxxx.us-east-1.rds.amazonaws.com>
POSTGRES_PORT=5432
POSTGRES_DB=geoplatform
POSTGRES_USER=geoplatform
POSTGRES_PASSWORD=<postgres_password from prod.tfvars>
POSTGRES_SSLMODE=require

# Airflow metadata database, created on RDS by the airflow-db-init one-shot
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=<new strong password: openssl rand -hex 16>

# ── S3 (buckets created by Terraform) ─────────────────────────────────────────
BUCKET_BRONZE=geoplatform-bronze
BUCKET_SILVER=geoplatform-silver
BUCKET_GOLD=geoplatform-gold
BUCKET_WAREHOUSE=geoplatform-warehouse

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=<airflow_fernet_key from prod.tfvars>
AIRFLOW_SECRET_KEY=<airflow_secret_key from prod.tfvars>
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=<new strong password>
AIRFLOW_ADMIN_EMAIL=<your email>

# ── Live weather (weather-producer and weather_historical_backfill) ──────────
OPENWEATHER_API_KEY=<openweather_api_key from prod.tfvars>

# ── Flink sized for an 8 GB host (t3.large) ──────────────────────────────────
FLINK_JOBMANAGER_MEMORY=768m
FLINK_TASKMANAGER_MEMORY=1536m
FLINK_TASK_SLOTS=2
FLINK_PARALLELISM=1

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=<gf_admin_password from prod.tfvars>

# Required by the base compose file for services the overlay never starts
# (minio, api). Their values never reach a running container.
MINIO_ROOT_USER=unused
MINIO_ROOT_PASSWORD=unused
JWT_SECRET=unused
